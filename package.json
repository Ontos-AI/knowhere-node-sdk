{
  "name": "@knowhere-ai/sdk",
  "version": "0.1.0",
  "description": "Official Node.js SDK for Knowhere document parsing API",
  "keywords": [
    "knowhere",
    "document-parsing",
    "pdf",
    "ocr",
    "document-intelligence"
  ],
  "author": "Knowhere Team <team@knowhereto.ai>",
  "license": "MIT",
  "homepage": "https://knowhereto.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ontos-AI/knowhere-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Ontos-AI/knowhere-node-sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jszip": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
